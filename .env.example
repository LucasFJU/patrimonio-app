# Browser: publishable key only. Never expose service_role or market token.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only
SUPABASE_SERVICE_ROLE_KEY=
# Server only: BRAPI token used by the existing stock analysis. Never use NEXT_PUBLIC_ for this token.
BRAPI_TOKEN=
# Long random secret for the Vercel scheduled job
CRON_SECRET=
# Optional: restrict manual market refresh to your Supabase auth user UUID
OWNER_USER_ID=
