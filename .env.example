# Browser: publishable key only. Never expose service_role or market token.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only
SUPABASE_SERVICE_ROLE_KEY=
# Server only: BolsAI API key used by the monthly stock analysis.
BOLSAI_API_KEY=
# Server only: Meu Pluggy API credentials; never prefix these with NEXT_PUBLIC_.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Long random secret for the Vercel scheduled job
CRON_SECRET=
# Required to enable Pluggy sync; use your Supabase auth user UUID (also restricts manual market refresh)
OWNER_USER_ID=
